<?xml version="1.0" encoding="utf-8"?>
<!-- 
    Data extraction rules for Android 12+.
    
    This configuration ensures that only necessary data is extracted during cloud backups.
    We exclude message data to maintain privacy compliance.
-->
<data-extraction-rules>
    <domain-config>
        <domain name="example.com">
            <excludes>
                <exclude-path path="/messages" />
            </excludes>
        </domain>
    </domain-config>
</data-extraction-rules>
